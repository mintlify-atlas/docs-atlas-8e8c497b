  "keyFeatures": [
    "Multi-store inventory tracking with real-time stock movements",
    "Purchase order lifecycle management (draft → sent → received → completed)",
    "Sales management with manual and automatic inventory assignment",
    "Financial analytics with cost analysis, pricing, and payables tracking",
    "Supplier management with RFC, contact info, and purchase history",
    "Outlet package bundling (Paquetes) with approval workflow",
    "Damage management and merchandise returns workflow",
    "Role-based access control with per-page permissions",
    "AI-powered assistant (Kassia) for inventory queries",
    "Automated CI/CD deployment via GitHub Actions and Docker"
  ],
  "publicApiSurface": [
    "GET/POST /api/productos — Product catalog CRUD",
    "GET/POST /api/inventario — Stock movements and queries",
    "GET/POST /api/ventas — Sales records",
    "POST /api/ventas/asignacion-manual — Manual inventory assignment",
    "GET/POST /api/ordenes-compra — Purchase order management",
    "POST /api/recepciones — Merchandise reception recording",
    "GET/POST /api/proveedores — Supplier management",
    "GET/POST /api/paquetes — Outlet package bundling",
    "GET/POST /api/pasivos — Supplier payment tracking",
    "GET /api/finanzas/analisis — Financial analysis reports",
    "GET /api/dashboard — Dashboard summary metrics",
    "GET/POST /api/usuarios — User and permission management",
    "POST /api/auth/[...nextauth] — NextAuth authentication",
    "POST /api/gestion-danos — Damaged goods management",
    "GET /api/notificaciones — Inventory notifications"
  ]
